+"""SAD proposal generation. Never writes to the source workbook or Jira."""
+from __future__ import annotations
+import io
+import re
+import uuid
+from difflib import SequenceMatcher
+from pathlib import Path
+import pandas as pd
+from fastapi import HTTPException
+from llm import LLMClient
+
+MAX_BYTES = 8 * 1024 * 1024
+MAX_CHARS = 70000
+TYPES = ('Epic', 'Feature', 'Story', 'Task')
+
+
+def extract_document(filename: str, content: bytes) -> str:
+    ext = Path(filename or '').suffix.lower()
+    if len(content) > MAX_BYTES:
+        raise HTTPException(413, 'SAD must be 8 MB or smaller')
+    if ext in ('.txt', '.md'):
+        try:
+            return content.decode('utf-8-sig')
+        except UnicodeDecodeError:
+            raise HTTPException(422, 'Upload UTF-8 text')
+    if ext == '.docx':
+        try:
+            from docx import Document
+            doc = Document(io.BytesIO(content))
+            return '\n'.join(p.text for p in doc.paragraphs if p.text.strip()) + '\n' + '\n'.join(' | '.join(c.text for c in row.cells) for table in doc.tables for row in table.rows)
+        except Exception as exc:
+            raise HTTPException(422, f'Unable to read DOCX: {exc}')
+    if ext == '.pdf':
+        try:
+            from pypdf import PdfReader
+            return '\n'.join(page.extract_text() or '' for page in PdfReader(io.BytesIO(content)).pages)
+        except Exception as exc:
+            raise HTTPException(422, f'Unable to read PDF: {exc}')
+    raise HTTPException(415, 'Supported SAD formats: PDF, DOCX, TXT, MD')
+
+
+def sections_from_text(text: str):
+    sections = []
+    current = None
+    for line in text.splitlines():
+        line = line.strip()
+        if not line:
+            continue
+        heading = re.match(r'^(?:#{1,4}\s+|(?:section\s+)?\d+(?:\.\d+)*[.)]?\s+)(.{3,100})$', line, re.I)
+        if heading:
+            current = {'id': f'section-{len(sections)+1}', 'title': heading.group(1).strip(), 'text': ''}
+            sections.append(current)
+        elif current:
+            current['text'] += line + '\n'
+        else:
+            current = {'id': 'section-1', 'title': 'Overview', 'text': line + '\n'}
+            sections.append(current)
+    return sections[:80]
+
+
+def _tokens(text):
+    return set(re.findall(r'[a-z0-9]{3,}', str(text).lower())) - {'the','and','for','with','from','this','that','into','should','shall','must','will','have','using'}
+
+
+def _candidate(proposal, backlog):
+    query = f"{proposal['title']} {proposal.get('description','')}"
+    q = _tokens(query)
+    found = []
+    for _, row in backlog.iterrows():
+        title = str(row.get('Title', ''))
+        body = f"{title} {row.get('Description', '')} {row.get('AcceptanceCriteria', '')}"
+        b = _tokens(body)
+        overlap = len(q & b) / max(1, len(q | b))
+        title_similarity = SequenceMatcher(None, proposal['title'].lower(), title.lower()).ratio()
+        score = round(max(overlap, title_similarity * .75), 3)
+        if score >= .28:
+            found.append({'ticket_id': str(row.get('TicketID','')), 'title': title, 'type': str(row.get('Type','')), 'status': str(row.get('Status','')), 'score': score, 'reason': 'Lexical/title candidate; compare scope and acceptance criteria before deciding.'})
+    return sorted(found, key=lambda item: item['score'], reverse=True)[:3]
+
+
+def generate_proposal(text: str, excel_path: Path, document_title: str):
+    text = text.strip()
+    if len(text) < 60:
+        raise HTTPException(422, 'Provide at least 60 characters of architecture content')
+    if len(text) > MAX_CHARS:
+        raise HTTPException(413, f'SAD text must be {MAX_CHARS} characters or fewer')
+    sections = sections_from_text(text)
+    llm = LLMClient()
+    if not llm.enabled:
+        raise HTTPException(503, 'SAD generation requires LLM_PROVIDER=groq or bedrock. No tickets were generated.')
+    prompt = ('You convert a system architecture document into delivery work. Return ONLY JSON with key tickets: array of objects. '
+              'Each object has temp_id, parent_temp_id (empty for Epic), type (Epic, Feature, Story, Task), title, description, acceptance_criteria (array of strings), source_section_id, source_excerpt (verbatim short quote), assumptions (array). '
+              'Hierarchy Epic -> Feature -> Story/Task. Cover application, security, infrastructure, QA, observability and release when actually supported by the SAD. '
+              'Never invent requirements; mark uncertainty in assumptions. Do not create Jira IDs. Do not claim existing backlog is absent. '
+              'Keep source_section_id from supplied sections and ensure unique temp_id values. Max 60 tickets.')
+    try:
+        output = llm.generate_json(prompt, str({'document_title':document_title, 'sections':sections})[:MAX_CHARS], max_tokens=7000)
+    except Exception as exc:
+        raise HTTPException(502, f'SAD generation provider failed: {exc}')
+    raw = output.get('tickets')
+    if not isinstance(raw, list) or not raw:
+        raise HTTPException(502, 'Model did not return a valid tickets array; please retry or revise the document')
+    by_source = {s['id']:s for s in sections}
+    prepared = []
+    id_map = {}
+    for item in raw[:60]:
+        if not isinstance(item, dict) or item.get('type') not in TYPES or not str(item.get('title','')).strip():
+            continue
+        original = str(item.get('temp_id','')).strip()
+        if not original or original in id_map:
+            raise HTTPException(502, 'Generated ticket IDs are missing or duplicated')
+        id_map[original] = f'sad-{uuid.uuid4().hex[:12]}'
+    for item in raw[:60]:
+        if not isinstance(item, dict) or str(item.get('temp_id','')) not in id_map:
+            continue
+        kind = item['type']
+        parent = str(item.get('parent_temp_id') or '').strip()
+        if kind != 'Epic' and parent not in id_map:
+            raise HTTPException(502, f'Generated {kind} has no valid parent')
+        if kind == 'Epic' and parent:
+            raise HTTPException(502, 'Generated Epic unexpectedly has a parent')
+        source_id = str(item.get('source_section_id',''))
+        if source_id not in by_source:
+            raise HTTPException(502, 'Generated ticket has an unknown SAD source section')
+        criteria = item.get('acceptance_criteria', [])
+        prepared.append({'id':id_map[str(item['temp_id'])], 'parent_id':id_map.get(parent,''), 'type':kind, 'title':str(item['title']).strip()[:255], 'description':str(item.get('description','')).strip(), 'acceptance_criteria':[str(x) for x in criteria] if isinstance(criteria,list) else [], 'source_section_id':source_id, 'source_excerpt':str(item.get('source_excerpt',''))[:500], 'assumptions':item.get('assumptions',[]) if isinstance(item.get('assumptions',[]),list) else []})
+    types_by_id = {item['id']:item['type'] for item in prepared}
+    for item in prepared:
+        expected = {'Feature':'Epic','Story':'Feature','Task':'Feature'}.get(item['type'])
+        if expected and types_by_id.get(item['parent_id']) != expected:
+            raise HTTPException(502, f"Generated {item['type']} has invalid parent hierarchy")
+    backlog = pd.read_excel(excel_path, sheet_name='Backlog').fillna('')
+    for item in prepared:
+        item['duplicate_candidates'] = _candidate(item, backlog)
+        item['review_status'] = 'potential_duplicate' if item['duplicate_candidates'] else 'new_proposal'
+    return {'document_title':document_title, 'sections':[{'id':s['id'],'title':s['title']} for s in sections], 'tickets':prepared, 'coverage': [{'section_id':s['id'],'title':s['title'],'ticket_count':sum(t['source_section_id']==s['id'] for t in prepared)} for s in sections], 'duplicate_method':'Lexical/title candidate screening; human review required. No semantic verification claimed.', 'publish_status':'draft_only'}
